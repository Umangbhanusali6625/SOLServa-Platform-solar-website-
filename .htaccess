# ===================================================================
# SOLServa Greentech - Apache / cPanel Server Configuration (.htaccess)
# Domain: solserva.in
# ===================================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1.1 Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://solserva.in/$1 [R=301,L]

  # 1.2 Force non-WWW (canonical domain https://solserva.in/)
  RewriteCond %{HTTP_HOST} ^www\.solserva\.in$ [NC]
  RewriteRule ^(.*)$ https://solserva.in/$1 [R=301,L]

  # 1.3 301 Redirect /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://solserva.in/ [R=301,L]

  # 1.4 301 Redirect *.html to clean URL (strip .html from address bar)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP/
  RewriteRule ^(.*)\.html$ https://solserva.in/$1 [R=301,L]

  # 1.5 Internal Rewrite: serve .html files for clean URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 2. Security Headers
<IfModule mod_headers.c>
  # HTTP Strict Transport Security (HSTS) - 2 years + preload
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking Protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://api.web3forms.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self';"
</IfModule>

# 3. Compression & Caching (Gzip / Brotli)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

